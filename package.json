{
  "name": "bazaar-build-recommender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enter the items you already have; get ranked recommendations for what to look for next.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch-data": "tsx scripts/fetch-bazaardb.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
